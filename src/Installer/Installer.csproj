<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.6.2 ships with Windows 10 1607 / Windows Server 2016 and later, so the installer runs on a
         stock Windows server without installing a runtime. -->
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>LabApiMobile.Installer</AssemblyName>
    <RootNamespace>LabApiMobile.Installer</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>
</Project>
