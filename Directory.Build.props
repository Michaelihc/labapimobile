<Project>
  <PropertyGroup>
    <!-- Carl Mod server Managed folder; produced by tools/extract-server.py from the reference ZIP. -->
    <CarlManaged Condition="'$(CarlManaged)' == ''">$(MSBuildThisFileDirectory).runtime\server-original\Carl Mod_Data\Managed</CarlManaged>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
